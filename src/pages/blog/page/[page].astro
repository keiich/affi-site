---
import type { GetStaticPaths } from 'astro';
import PostListPage from '../../../components/PostListPage.astro';
import { POSTS_PER_PAGE } from '../../../consts';
import { getPublishedPosts } from '../../../utils/posts';

// 2ページ目以降を生成（1ページ目は /blog/）
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const last = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => {
    const current = i + 2;
    const start = (current - 1) * POSTS_PER_PAGE;
    return {
      params: { page: String(current) },
      props: { posts: posts.slice(start, start + POSTS_PER_PAGE), current, last },
    };
  });
}) satisfies GetStaticPaths;

const { posts, current, last } = Astro.props;
---

<PostListPage posts={posts} current={current} last={last} />
