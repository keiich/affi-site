---
export interface Props {
  current: number;
  last: number;
}

const { current, last } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`);
---

{
  last > 1 && (
    <nav class="pagination" aria-label="ページ送り">
      {current > 1 ? <a href={pageUrl(current - 1)} rel="prev">← 前へ</a> : <span />}
      <span class="pagination-current">
        {current} / {last}
      </span>
      {current < last ? <a href={pageUrl(current + 1)} rel="next">次へ →</a> : <span />}
    </nav>
  )
}
