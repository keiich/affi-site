---
// 記事一覧ページ本体（/blog/ と /blog/page/N/ で共用）
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../utils/posts';

export interface Props {
  posts: Post[];
  current: number;
  last: number;
}

const { posts, current, last } = Astro.props;
const title = current === 1 ? '記事一覧' : `記事一覧（${current}ページ目）`;
---

<BaseLayout title={title} description="つくるノートの記事一覧です。AI動画制作ツールの使い方・比較・制作記録をまとめています。">
  <h1 class="page-title">{title}</h1>
  <div class="post-list">
    {posts.map((post, i) => <PostCard post={post} eager={i === 0} />)}
  </div>
  <Pagination current={current} last={last} />
</BaseLayout>
